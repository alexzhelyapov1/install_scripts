# Generated by install_scripts (steps/services.sh) from templates/systemd/sendme-bot.service. Edit the template.
[Unit]
Description=sendme-bot: sends files to Telegram on request through a unix socket
After=network-online.target

[Service]
WorkingDirectory=${SENDME_BOT_DIR}
ExecStart=${SENDME_BOT_DIR}/venv/bin/python3 ${SENDME_BOT_DIR}/daemon.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
