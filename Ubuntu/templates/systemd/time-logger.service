# Generated by install_scripts (steps/services.sh) from templates/systemd/time-logger.service. Edit the template.
[Unit]
Description=time-logger: web app on http://127.0.0.1:5000

[Service]
WorkingDirectory=${TIME_LOGGER_DIR}
ExecStart=${TIME_LOGGER_DIR}/venv/bin/python3 ${TIME_LOGGER_DIR}/app.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
