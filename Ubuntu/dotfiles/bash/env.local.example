# ----------------------------------------------------------------------------------------------------------------------
# Machine-specific settings. Not tracked by git.
# Create the real file next to this one and check the values:
#   cp env.local.example env.local
# Read by install.sh and by env.sh (every new shell).
# ----------------------------------------------------------------------------------------------------------------------

# Work storage. Must stay /mnt/storage/gravilink: agent memory and skills refer to this path.
export GRAVILINK_DIR="/mnt/storage/gravilink"

# Personal tools that live next to the work repositories
export SENDME_BOT_DIR="$GRAVILINK_DIR/sendme-bot"
export TIME_LOGGER_DIR="$GRAVILINK_DIR/time-logger"

# Agent memory and configs sync (wsg)
export WORK_SETUP_DIR="$HOME/work-setup-gravilink"
